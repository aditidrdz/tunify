# ============================================================================
# Tunify environment variables.
# Copy this file to ".env" (same folder) and fill in the values you actually
# want to use. The .env file is loaded automatically on app start.
# ============================================================================

# Required only if you want to store users + likes in MongoDB Atlas.
# Get this from Atlas: Database -> Connect -> Drivers -> Python.
# Looks like: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Leave UNSET to keep using the local data/users.json file.
MONGODB_URI=

# Optional. Defaults to "tunify".
MONGODB_DB=tunify

# Optional. Random string used to sign Flask sessions. Set to something secret
# in production.
TUNIFY_SECRET=change-me-to-something-random
